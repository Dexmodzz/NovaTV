<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: pill button. Focused: white fill (text should switch to nova_text_on_light). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_text_primary"/>
            <corners android:radius="@dimen/nova_radius_pill"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_text_primary"/>
            <corners android:radius="@dimen/nova_radius_pill"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_surface_2"/>
            <stroke android:width="@dimen/nova_border_width" android:color="@color/nova_border"/>
            <corners android:radius="@dimen/nova_radius_pill"/>
        </shape>
    </item>
</selector>
