<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: play/pause = white button with dark icon; focus = accent ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_text_primary"/>
            <stroke android:width="3dp" android:color="@color/nova_accent_blue"/>
            <corners android:radius="@dimen/nova_radius_pill"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_text_primary"/>
            <corners android:radius="@dimen/nova_radius_pill"/>
        </shape>
    </item>
</selector>
