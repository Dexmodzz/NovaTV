<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: dark gradient behind the controls (bottom) and the header (top), the video stays visible in the middle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerY="0.28"
                android:startColor="@color/nova_player_scrim"
                android:centerColor="#B30F0F10"
                android:endColor="#000F0F10"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top band only (~1/3 of a 540dp TV screen) -->
    <item android:bottom="@dimen/nova_player_top_scrim_inset">
        <shape>
            <gradient
                android:angle="270"
                android:centerY="0.45"
                android:startColor="@color/nova_player_scrim_top"
                android:centerColor="#660F0F10"
                android:endColor="#000F0F10"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
