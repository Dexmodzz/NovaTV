<!-- NovaTV: dark pill search field (was a light grey #EEEEEE pill) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/nova_surface_2"/>

    <stroke android:width="@dimen/nova_border_width" android:color="@color/nova_border"/>

    <corners android:radius="@dimen/nova_radius_pill"/>

    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp"/>
</shape>
