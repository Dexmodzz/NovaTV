<?xml version="1.0" encoding="utf-8"?>
<!--
    NovaTV themes. All legacy SmartTube color schemes (MainUIData.initColorSchemes) point here:
    dark variants -> App.Theme.Nova.Dark.*, OLED variants -> App.Theme.Nova.Oled.*.
    They extend the upstream App.Theme.Leanback.* themes, so window/fullscreen tweaks stay intact.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Current accent color resource, readable from code via Helpers.getThemeAttr() -->
    <attr name="novaAccent" format="reference"/>
    <!-- Accent-dependent drawables (no ?attr colors inside drawables before API 21) -->
    <attr name="novaChipBg" format="reference"/>
    <attr name="novaPlayBg" format="reference"/>

    <!-- Card watch-progress styles, one per accent -->
    <style name="NovaProgress.Orange" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/novatv_progress_orange</item>
    </style>
    <style name="NovaProgress.Blue" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/novatv_progress_blue</item>
    </style>
    <style name="NovaProgress.Violet" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/novatv_progress_violet</item>
    </style>
    <style name="NovaProgress.Green" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/novatv_progress_green</item>
    </style>

    <!-- Narrow side rail: headers grid fits the 112dp rail -->
    <style name="NovaRailGridStyle" parent="BrowseHeaderStyle">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:verticalSpacing">4dp</item>
    </style>

    <!-- Compact header (title view): leaves room for the chips row above the content -->
    <style name="NovaTitleViewStyle" parent="Widget.Leanback.TitleView">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- ===================== Dark (default) ===================== -->
    <style name="App.Theme.Nova.Dark.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/nova_bg</item>
        <!-- Transparent rail background: the raised panel (lb_headers_fragment.xml) is the background -->
        <item name="brandColor">@android:color/transparent</item>
        <item name="brandAccentColor">@color/nova_accent</item>
        <item name="shelfBackground">@color/nova_bg</item>
        <item name="cardDefaultBackground">@color/nova_surface</item>
        <item name="cardSelectedBackground">@color/nova_surface</item>
        <item name="cardProgressStyle">@style/NovaProgress.Orange</item>
        <item name="appLogo">@mipmap/novatv_logo</item>
        <item name="headersVerticalGridStyle">@style/NovaRailGridStyle</item>
        <item name="browseTitleViewStyle">@style/NovaTitleViewStyle</item>
        <item name="novaAccent">@color/nova_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent</item>
        <item name="android:colorPrimary" tools:targetApi="21">@color/nova_surface</item>
        <item name="android:textColorPrimary">@color/nova_text_primary</item>
        <item name="android:textColorSecondary">@color/nova_text_secondary</item>
    </style>
    <style name="App.Theme.Nova.Dark.Player" parent="App.Theme.Leanback.Player">
        <!-- Video area stays pure black -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="shelfBackground">@color/nova_bg</item>
        <item name="cardDefaultBackground">@color/nova_surface</item>
        <item name="cardSelectedBackground">@color/nova_surface</item>
        <item name="cardProgressStyle">@style/NovaProgress.Orange</item>
        <item name="novaAccent">@color/nova_accent</item>
        <item name="playbackProgressPrimaryColor">@color/nova_accent</item>
        <item name="playbackProgressSecondaryColor">@color/nova_player_buffered</item>
        <item name="playbackControlsIconHighlightColor">@color/nova_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent</item>
    </style>
    <style name="App.Theme.Nova.Dark.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="novaAccent">@color/nova_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent</item>
        <item name="android:colorPrimary" tools:targetApi="21">@color/nova_surface</item>
    </style>

    <!-- ===================== OLED (pure black) ===================== -->
    <style name="App.Theme.Nova.Oled.Browse" parent="App.Theme.Nova.Dark.Browse">
        <item name="android:windowBackground">@color/nova_bg_oled</item>
        <!-- Transparent rail background: the raised panel (lb_headers_fragment.xml) is the background -->
        <item name="brandColor">@android:color/transparent</item>
        <item name="shelfBackground">@color/nova_bg_oled</item>
    </style>
    <style name="App.Theme.Nova.Oled.Player" parent="App.Theme.Nova.Dark.Player">
        <item name="shelfBackground">@color/nova_bg_oled</item>
    </style>
    <style name="App.Theme.Nova.Oled.Preferences" parent="App.Theme.Nova.Dark.Preferences"/>

    <!-- ===================== Accent overlays (NovaTVData.applyAccent) ===================== -->
    <style name="NovaAccent.Orange" parent="">
        <item name="novaAccent">@color/nova_accent_orange</item>
        <item name="brandAccentColor">@color/nova_accent_orange</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent_orange</item>
        <item name="playbackProgressPrimaryColor">@color/nova_accent_orange</item>
        <item name="playbackControlsIconHighlightColor">@color/nova_accent_orange</item>
        <item name="cardProgressStyle">@style/NovaProgress.Orange</item>
        <item name="novaChipBg">@drawable/novatv_chip_bg</item>
        <item name="novaPlayBg">@drawable/novatv_player_play_bg</item>
    </style>
    <style name="NovaAccent.Blue" parent="">
        <item name="novaAccent">@color/nova_accent_blue</item>
        <item name="brandAccentColor">@color/nova_accent_blue</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent_blue</item>
        <item name="playbackProgressPrimaryColor">@color/nova_accent_blue</item>
        <item name="playbackControlsIconHighlightColor">@color/nova_accent_blue</item>
        <item name="cardProgressStyle">@style/NovaProgress.Blue</item>
        <item name="novaChipBg">@drawable/novatv_chip_bg_blue</item>
        <item name="novaPlayBg">@drawable/novatv_player_play_bg_blue</item>
    </style>
    <style name="NovaAccent.Violet" parent="">
        <item name="novaAccent">@color/nova_accent_violet</item>
        <item name="brandAccentColor">@color/nova_accent_violet</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent_violet</item>
        <item name="playbackProgressPrimaryColor">@color/nova_accent_violet</item>
        <item name="playbackControlsIconHighlightColor">@color/nova_accent_violet</item>
        <item name="cardProgressStyle">@style/NovaProgress.Violet</item>
        <item name="novaChipBg">@drawable/novatv_chip_bg_violet</item>
        <item name="novaPlayBg">@drawable/novatv_player_play_bg_violet</item>
    </style>
    <style name="NovaAccent.Green" parent="">
        <item name="novaAccent">@color/nova_accent_green</item>
        <item name="brandAccentColor">@color/nova_accent_green</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/nova_accent_green</item>
        <item name="playbackProgressPrimaryColor">@color/nova_accent_green</item>
        <item name="playbackControlsIconHighlightColor">@color/nova_accent_green</item>
        <item name="cardProgressStyle">@style/NovaProgress.Green</item>
        <item name="novaChipBg">@drawable/novatv_chip_bg_green</item>
        <item name="novaPlayBg">@drawable/novatv_player_play_bg_green</item>
    </style>
</resources>
