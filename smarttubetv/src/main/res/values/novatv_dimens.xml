<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV design tokens: shapes and spacing -->
<resources>
    <!-- Corner radii -->
    <dimen name="nova_radius_card">14dp</dimen>
    <dimen name="nova_radius_small">8dp</dimen>
    <!-- Large enough to turn any button height into a pill -->
    <dimen name="nova_radius_pill">999dp</dimen>

    <!-- Borders / focus -->
    <dimen name="nova_border_width">1dp</dimen>
    <dimen name="nova_focus_outline_width">4dp</dimen>
    <item name="nova_focus_scale" format="float" type="dimen">1.05</item>
    <integer name="nova_focus_anim_ms">150</integer>

    <!-- Spacing scale -->
    <dimen name="nova_space_xs">4dp</dimen>
    <dimen name="nova_space_s">8dp</dimen>
    <dimen name="nova_space_m">12dp</dimen>
    <dimen name="nova_space_l">16dp</dimen>
    <dimen name="nova_space_xl">24dp</dimen>

    <!-- Pill buttons -->
    <dimen name="nova_pill_height">40dp</dimen>
    <dimen name="nova_pill_padding_h">18dp</dimen>

    <!-- Video cards -->
    <dimen name="nova_card_avatar_size">32dp</dimen>
    <!-- Focused card zoom 1.05 (Leanback "small" zoom, used by all rows/grids; default 110%) -->
    <item name="lb_focus_zoom_factor_small" type="fraction">105%</item>

    <!-- Progress -->
    <dimen name="nova_progress_height">4dp</dimen>

    <!-- Type scale -->
    <dimen name="nova_text_title">18sp</dimen>
    <dimen name="nova_text_body">14sp</dimen>
    <dimen name="nova_text_caption">12sp</dimen>

    <!-- Header (title view) -->
    <dimen name="nova_header_height">52dp</dimen>
    <dimen name="nova_header_logo_height">30dp</dimen>
    <dimen name="nova_header_icon_size">24dp</dimen>
    <dimen name="nova_header_clock_size">22sp</dimen>
    <dimen name="nova_search_pill_height">44dp</dimen>
    <dimen name="nova_search_mic_size">36dp</dimen>
    <!-- Search screen bar = home header: same logo, pill and right button positions (measured on the home header) -->
    <dimen name="nova_header_logo_width">109dp</dimen> <!-- logo 1087x300 at 30dp height -->
    <dimen name="nova_search_screen_pill_height">@dimen/nova_search_pill_height</dimen>
    <dimen name="nova_search_screen_logo_margin">56dp</dimen>
    <dimen name="nova_search_screen_pill_margin">17dp</dimen>
    <!-- Settings button next to the pill: 17dp visible gap minus the 4dp lost by scaling 52dp to 44dp -->
    <dimen name="nova_search_screen_settings_margin">13dp</dimen>
    <!-- Visible right edge 56dp from the screen edge, like the home avatar (52dp + 4dp lost by scaling) -->
    <dimen name="nova_search_screen_settings_end_margin">52dp</dimen>
    <item name="nova_search_screen_settings_scale" format="float" type="dimen">0.846</item>
    <!-- Bar centred where the home header items are (Leanback default 27dp) -->
    <dimen name="lb_search_bar_padding_top">14dp</dimen>
    <!-- Search results: first row right below the search bar (14dp + 52dp bar + 8dp gap); the selected row
         (videos under the suggestions row) is aligned lower (Leanback default 147dp) -->
    <dimen name="nova_search_results_top">74dp</dimen>
    <dimen name="lb_search_browse_rows_align_top">152dp</dimen>
    <!-- Voice orb fits inside the pill, also when zoomed on focus (Leanback default 52dp) -->
    <dimen name="lb_search_bar_speech_orb_size">36dp</dimen>
    <dimen name="nova_pip_title_max_width">260dp</dimen>

    <!-- Search screen: the dark field is always fully opaque (Leanback fades it to 20%/70%) -->
    <integer name="lb_search_bar_text_mode_background_alpha">255</integer>
    <integer name="lb_search_bar_speech_mode_background_alpha">255</integer>

    <!-- Category chips -->
    <dimen name="nova_chip_height">36dp</dimen>
    <dimen name="nova_chip_padding_h">18dp</dimen>
    <dimen name="nova_chip_spacing">10dp</dimen>

    <!-- Side rail (Leanback headers) -->
    <dimen name="lb_browse_headers_width">112dp</dimen>
    <!-- No zoom on the selected rail item (Leanback default 1.2) -->
    <item name="lb_browse_header_select_scale" format="float" type="dimen">1.0</item>
    <dimen name="nova_rail_item_width">88dp</dimen>
    <dimen name="nova_rail_item_padding">10dp</dimen>
    <dimen name="nova_rail_icon_size">28dp</dimen>
    <dimen name="nova_rail_label_size">11sp</dimen>
    <!-- Player (phase 4) -->
    <dimen name="nova_player_button_size">48dp</dimen>
    <dimen name="nova_player_play_size">56dp</dimen>
    <dimen name="nova_player_button_padding">8dp</dimen>
    <dimen name="nova_player_icon_size">28dp</dimen>
    <dimen name="nova_player_label_size">15sp</dimen>
    <dimen name="nova_player_label_max_width">150dp</dimen>
    <!-- Min gap between player buttons (a widened, labeled button pushes its neighbours) -->
    <dimen name="nova_player_button_min_gap">10dp</dimen>
    <dimen name="nova_player_top_scrim_inset">360dp</dimen>
    <!-- Player header -->
    <dimen name="nova_player_header_padding_h">56dp</dimen>
    <dimen name="nova_player_header_padding_top">28dp</dimen>
    <dimen name="nova_player_header_avatar_size">28dp</dimen>
    <!-- Room kept free on both sides of the centered top title (the clock is in the right corner) -->
    <dimen name="nova_player_header_side_space">120dp</dimen>
    <dimen name="nova_player_time_min_width">56dp</dimen>
    <!-- Centered rows: no negative start offset -->
    <dimen name="lb_playback_transport_controlbar_margin_start">0dp</dimen>
    <dimen name="nova_player_header_title_size">22sp</dimen>
    <dimen name="nova_player_header_subtitle_size">14sp</dimen>
    <!-- Thicker progress bar -->
    <dimen name="lb_playback_transport_progressbar_bar_height">6dp</dimen>
    <dimen name="lb_playback_transport_progressbar_active_bar_height">10dp</dimen>
    <dimen name="lb_playback_transport_progressbar_active_radius">10dp</dimen>
</resources>
