<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV design tokens: shapes and spacing -->
<resources>
    <!-- Corner radii -->
    <dimen name="nova_radius_card">14dp</dimen>
    <dimen name="nova_radius_small">8dp</dimen>
    <!-- Large enough to turn any button height into a pill -->
    <dimen name="nova_radius_pill">999dp</dimen>

    <!-- Borders / focus -->
    <dimen name="nova_border_width">1dp</dimen>
    <dimen name="nova_focus_outline_width">4dp</dimen>
    <item name="nova_focus_scale" format="float" type="dimen">1.05</item>
    <integer name="nova_focus_anim_ms">150</integer>

    <!-- Spacing scale -->
    <dimen name="nova_space_xs">4dp</dimen>
    <dimen name="nova_space_s">8dp</dimen>
    <dimen name="nova_space_m">12dp</dimen>
    <dimen name="nova_space_l">16dp</dimen>
    <dimen name="nova_space_xl">24dp</dimen>

    <!-- Pill buttons -->
    <dimen name="nova_pill_height">40dp</dimen>
    <dimen name="nova_pill_padding_h">18dp</dimen>

    <!-- Video cards -->
    <dimen name="nova_card_avatar_size">32dp</dimen>
    <!-- Focused card zoom 1.05 (Leanback "small" zoom, used by all rows/grids; default 110%) -->
    <item name="lb_focus_zoom_factor_small" type="fraction">105%</item>

    <!-- Progress -->
    <dimen name="nova_progress_height">4dp</dimen>

    <!-- Type scale -->
    <dimen name="nova_text_title">18sp</dimen>
    <dimen name="nova_text_body">14sp</dimen>
    <dimen name="nova_text_caption">12sp</dimen>

    <!-- Header (title view) -->
    <dimen name="nova_header_height">52dp</dimen>
    <dimen name="nova_header_logo_height">30dp</dimen>
    <dimen name="nova_header_icon_size">24dp</dimen>
    <dimen name="nova_header_clock_size">22sp</dimen>
    <dimen name="nova_search_pill_width">480dp</dimen>
    <dimen name="nova_search_pill_height">44dp</dimen>
    <dimen name="nova_search_mic_size">36dp</dimen>
    <dimen name="nova_search_screen_pill_height">56dp</dimen>
    <!-- Search screen: aligns the logo with the home header one (SearchBar already has a start padding) -->
    <dimen name="nova_search_screen_logo_margin">18dp</dimen>
    <!-- Voice orb fits inside the pill, also when zoomed on focus (Leanback default 52dp) -->
    <dimen name="lb_search_bar_speech_orb_size">40dp</dimen>
    <dimen name="nova_pip_title_max_width">260dp</dimen>

    <!-- Search screen: the dark field is always fully opaque (Leanback fades it to 20%/70%) -->
    <integer name="lb_search_bar_text_mode_background_alpha">255</integer>
    <integer name="lb_search_bar_speech_mode_background_alpha">255</integer>

    <!-- Category chips -->
    <dimen name="nova_chip_height">36dp</dimen>
    <dimen name="nova_chip_padding_h">18dp</dimen>
    <dimen name="nova_chip_spacing">10dp</dimen>

    <!-- Side rail (Leanback headers) -->
    <dimen name="lb_browse_headers_width">112dp</dimen>
    <!-- No zoom on the selected rail item (Leanback default 1.2) -->
    <item name="lb_browse_header_select_scale" format="float" type="dimen">1.0</item>
    <dimen name="nova_rail_item_width">88dp</dimen>
    <dimen name="nova_rail_item_padding">10dp</dimen>
    <dimen name="nova_rail_icon_size">28dp</dimen>
    <dimen name="nova_rail_label_size">11sp</dimen>
</resources>
