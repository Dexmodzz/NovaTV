<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: pill text, dark on the white focused/selected pill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/nova_text_on_light"/>
    <item android:state_selected="true" android:color="@color/nova_text_on_light"/>
    <item android:color="@color/nova_text_primary"/>
</selector>
