<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: side rail item = icon above a small label (ids unchanged) -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_rail_item"
    android:layout_width="@dimen/nova_rail_item_width"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/nova_rail_item_padding"
    android:paddingBottom="@dimen/nova_rail_item_padding">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="@dimen/nova_rail_icon_size"
        android:layout_height="@dimen/nova_rail_icon_size"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"

        android:singleLine="true"
        android:maxWidth="@dimen/nova_rail_item_width"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        android:textSize="@dimen/nova_rail_label_size"
        android:textColor="@color/nova_text_secondary"
        android:includeFontPadding="false"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>
