<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: player title block, placed above the info line (views, date, likes) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_player_title_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/nova_space_s"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/nova_player_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:includeFontPadding="false"
        android:textColor="@color/nova_text_primary"
        android:textSize="@dimen/nova_player_header_title_size"
        android:textStyle="bold"
        android:shadowColor="#99000000"
        android:shadowRadius="4" />

    <LinearLayout
        android:id="@+id/nova_player_channel_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nova_player_channel_avatar"
            android:layout_width="@dimen/nova_player_header_avatar_size"
            android:layout_height="@dimen/nova_player_header_avatar_size"
            android:layout_marginEnd="@dimen/nova_space_s"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/nova_player_channel_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/nova_text_secondary"
            android:textSize="@dimen/nova_player_header_subtitle_size"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />
    </LinearLayout>
</LinearLayout>
