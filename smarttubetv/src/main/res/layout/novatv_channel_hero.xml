<?xml version="1.0" encoding="utf-8"?>
<!-- NovaTV: channel page header, like the channel page on the web: banner, avatar over the banner edge,
     name, @handle, subscribers · videos and the subscribe/unsubscribe button. Filled by NovaChannelHero -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nova_channel_hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/nova_channel_hero_padding_start"
    android:paddingEnd="@dimen/nova_channel_hero_padding_end"
    android:paddingTop="@dimen/nova_channel_hero_padding_top"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <ImageView
        android:id="@+id/nova_channel_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nova_channel_banner_height"
        android:background="@drawable/novatv_channel_banner_bg"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nova_channel_avatar_top"
        android:paddingStart="@dimen/nova_channel_avatar_start"
        android:clipChildren="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nova_channel_avatar"
            android:layout_width="@dimen/nova_channel_avatar_size"
            android:layout_height="@dimen/nova_channel_avatar_size"
            android:background="@drawable/novatv_channel_avatar_ring"
            android:padding="@dimen/nova_channel_avatar_ring"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/nova_space_l"
            android:layout_marginTop="@dimen/nova_channel_text_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nova_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/nova_text_primary"
                android:textSize="@dimen/nova_channel_name_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nova_channel_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nova_space_s"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/nova_text_secondary"
                android:textSize="@dimen/nova_channel_meta_size" />

            <TextView
                android:id="@+id/nova_channel_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/nova_channel_button_height"
                android:layout_marginTop="@dimen/nova_space_m"
                android:paddingStart="@dimen/nova_channel_button_padding"
                android:paddingEnd="@dimen/nova_channel_button_padding"
                android:gravity="center"
                android:background="@drawable/novatv_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textSize="@dimen/nova_channel_button_text_size"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
